{
  "awsAuthRefresh": "aws sso login --profile <YOUR_AWS_PROFILE>",
  "env": {
    "AWS_PROFILE": "<YOUR_AWS_PROFILE>",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "65536",
    "MAX_THINKING_TOKENS": "8192"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "make -C ~/Documents/dotfiles skills-sync"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "<TEAM_PLUGIN>@<TEAM_MARKETPLACE>": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "high"
}
